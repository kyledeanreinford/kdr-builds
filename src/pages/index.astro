---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			{featured && (
				<article class="lead">
					<p class="kicker">Above the fold</p>
					<a href={`/blog/${featured.id}/`} class="lead-link">
						<h1>{featured.data.title}</h1>
						{featured.data.description && (
							<p class="dek">{featured.data.description}</p>
						)}
					</a>
					<p class="byline">
						<FormattedDate date={featured.data.pubDate} />
						{featured.data.tags.length > 0 && <span>· {featured.data.tags.join(' · ')}</span>}
					</p>
				</article>
			)}

			<div class="divider"></div>

			<section class="more">
				<h2 class="section-title">More from the workshop</h2>
				<div class="cols">
					{rest.map((post) => (
						<article class="entry">
							<a href={`/blog/${post.id}/`}>
								<h3>{post.data.title}</h3>
								{post.data.description && <p class="entry-dek">{post.data.description}</p>}
								<p class="entry-meta">
									<FormattedDate date={post.data.pubDate} />
									{post.data.tags.length > 0 && <span>· {post.data.tags.slice(0, 3).join(' · ')}</span>}
								</p>
							</a>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.lead {
		max-width: var(--measure);
	}
	.kicker {
		font-family: var(--sans);
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-size: 0.7rem;
		color: var(--accent);
		margin: 0 0 1rem;
		font-weight: 500;
	}
	.lead-link {
		text-decoration: none;
		color: inherit;
	}
	.lead-link:hover h1 {
		color: var(--accent);
	}
	.lead h1 {
		font-weight: 800;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.04;
		letter-spacing: -0.028em;
		margin: 0 0 1rem;
		transition: color 0.15s ease;
	}
	.dek {
		font-size: 1.15rem;
		font-style: italic;
		color: var(--text-soft);
		line-height: 1.55;
		margin: 0 0 1.2rem;
	}
	.byline {
		font-family: var(--sans);
		font-size: 0.78rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin: 0;
	}

	.divider {
		border-top: 1px solid var(--rule);
		margin: 3rem 0 2.5rem;
	}

	.section-title {
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.22em;
		color: var(--text-muted);
		margin: 0 0 2rem;
	}

	.cols {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem 2.5rem;
	}
	.entry {
		border-top: 1px solid var(--rule-soft);
		padding-top: 1.25rem;
	}
	.entry a {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.entry a:hover h3 {
		color: var(--accent);
	}
	.entry h3 {
		font-weight: 600;
		font-size: 1.35rem;
		line-height: 1.2;
		letter-spacing: -0.018em;
		margin: 0 0 0.55rem;
		transition: color 0.15s ease;
	}
	.entry-dek {
		font-size: 0.95rem;
		color: var(--text-soft);
		line-height: 1.5;
		margin: 0 0 0.7rem;
	}
	.entry-meta {
		font-family: var(--sans);
		font-size: 0.72rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin: 0;
	}

	@media (max-width: 700px) {
		.cols { grid-template-columns: 1fr; gap: 1.5rem; }
	}
</style>
